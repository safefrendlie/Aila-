# --- ZARURI ---
# Google AI Studio se free key (aistudio.google.com -> Get API key)
GEMINI_API_KEY=

# --- OPTIONAL ---
# Model ka naam (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Jo bhi tumhari site khole use pehle passcode poochna hai (taaki koi aur tumhari free limit use na kare)
APP_PASSCODE=

# Permanent memory ke liye Supabase (Project Settings -> API)
# SUPABASE_URL = Project URL, SUPABASE_SERVICE_ROLE_KEY = service_role / secret key (isse KABHI public mat karna)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
